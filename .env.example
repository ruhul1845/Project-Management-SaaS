NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_management_saas?schema=public
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# Stripe test or live secret and webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_USD=1900

# Optional: attachment uploads (required only for the attachment endpoint)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: caching; the API runs normally when this is blank
REDIS_URL=

# Dedicated demo owner seeded with `npm run db:seed`
DEMO_OWNER_NAME=Demo Owner
DEMO_OWNER_EMAIL=owner@taskflow.dev
DEMO_OWNER_PASSWORD=Owner@12345
DEMO_ADMIN_NAME=TaskFlow Admin
DEMO_ADMIN_EMAIL=admin@taskflow.dev
DEMO_ADMIN_PASSWORD=Admin@12345
